#!/usr/bin/env bash
# Cadenza — set up and run the two applications:
#   demo-app  the owner's website (Symfony app with the Cadenza runtime bundle)   http://127.0.0.1:8010
#   harness   Cadenza Studio: the agent, proposals, MCP client of the site       http://127.0.0.1:8011
#
#   ./cadenza setup     install dependencies, create databases, build assets, generate a shared token
#   ./cadenza start     start both apps and the background worker (Symfony CLI, or PHP's built-in server;
#                       CADENZA_PHP_SERVER=1 forces the built-in one; CADENZA_APP_PORT / CADENZA_STUDIO_PORT)
#   ./cadenza stop      stop them
#   ./cadenza test      run all test suites
#   ./cadenza reset     start the site over from a blank canvas (history deleted)
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
APP="$ROOT/demo-app"
STUDIO="$ROOT/harness"
APP_PORT="${CADENZA_APP_PORT:-8010}"
STUDIO_PORT="${CADENZA_STUDIO_PORT:-8011}"
RUN="$ROOT/.run"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
step() { printf '\033[35m▸\033[0m %s\n' "$*"; }
fail() { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
has() { command -v "$1" >/dev/null 2>&1; }

check() {
    has php || fail "PHP 8.4+ is required."
    php -r 'exit(PHP_VERSION_ID >= 80400 ? 0 : 1);' || fail "PHP 8.4+ is required (found $(php -r 'echo PHP_VERSION;'))."
    local modules
    modules="$(php -m)"
    for ext in pdo_sqlite gd intl zip sodium; do
        grep -qix "$ext" <<<"$modules" || fail "PHP extension \"$ext\" is missing."
    done
    has composer || fail "Composer is required (https://getcomposer.org)."
}

env_local() { # file key value — set a key in .env.local unless it is already there
    local file="$1" key="$2" value="$3"
    touch "$file"
    grep -q "^$key=" "$file" || printf '%s=%s\n' "$key" "$value" >> "$file"
}

setup() {
    check
    bold "Cadenza setup"
    local token
    token="$(grep -h '^CADENZA_TOKEN=' "$APP/.env.local" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    [ -n "$token" ] || token="$(php -r 'echo bin2hex(random_bytes(24));')"

    step "Configuration (.env.local files, never committed)"
    env_local "$APP/.env.local" DATABASE_URL '"sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"'
    env_local "$APP/.env.local" CADENZA_TOKEN "$token"
    env_local "$APP/.env.local" CADENZA_HARNESS_URL "http://127.0.0.1:$STUDIO_PORT"
    env_local "$STUDIO/.env.local" DATABASE_URL '"sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"'
    env_local "$STUDIO/.env.local" CADENZA_TOKEN "$token"
    env_local "$STUDIO/.env.local" CADENZA_APP_URL "http://127.0.0.1:$APP_PORT"
    env_local "$STUDIO/.env.local" CADENZA_PUBLIC_URL "http://127.0.0.1:$STUDIO_PORT"

    for dir in "$APP" "$STUDIO"; do
        step "$(basename "$dir"): dependencies"
        (cd "$dir" && composer install --no-interaction --quiet)
        step "$(basename "$dir"): database"
        (cd "$dir" && php bin/console doctrine:migrations:migrate --no-interaction --quiet --allow-no-migration)
    done
    step "demo-app: assets"
    (cd "$APP" && php bin/console importmap:install --quiet && php bin/console tailwind:build --quiet)
    (cd "$APP" && php bin/console cadenza:init "My site" --quiet || true)

    bold "Done."
    if ! grep -q '^CADENZA_LLM_API_KEY=.\+' "$STUDIO/.env.local" 2>/dev/null && [ -z "${CADENZA_LLM_API_KEY:-}" ]; then
        echo
        echo "  Choose a model (any OpenAI-compatible API with tool calling) in harness/.env.local, e.g. Hugging Face:"
        echo "    CADENZA_LLM_API_KEY=hf_…"
        echo "  or OpenRouter / Ollama Cloud / LM Studio — see README.md, section \"Models\"."
    fi
    echo
    echo "  Next: ./cadenza start"
}

start() {
    mkdir -p "$RUN"
    if has symfony && [ -z "${CADENZA_PHP_SERVER:-}" ]; then
        step "Starting with the Symfony CLI"
        (cd "$APP" && symfony server:start -d --port="$APP_PORT" --no-tls --allow-all-ip >/dev/null)
        (cd "$STUDIO" && symfony server:start -d --port="$STUDIO_PORT" --no-tls >/dev/null)
    else
        step "Starting with PHP's built-in server (Symfony CLI not found)"
        stop >/dev/null 2>&1 # whatever an earlier start left running
        (cd "$APP" && PHP_CLI_SERVER_WORKERS=4 nohup php -c "$APP/php.ini" -S "0.0.0.0:$APP_PORT" -t public "$ROOT/bin/router.php" </dev/null >"$RUN/app.log" 2>&1 & echo $! >"$RUN/app.pid")
        (cd "$STUDIO" && PHP_CLI_SERVER_WORKERS=4 nohup php -c "$STUDIO/php.ini" -S "127.0.0.1:$STUDIO_PORT" -t public "$ROOT/bin/router.php" </dev/null >"$RUN/studio.log" 2>&1 & echo $! >"$RUN/studio.pid")
        (cd "$APP" && nohup php "$APP/bin/console" messenger:consume async scheduler_cadenza </dev/null >"$RUN/worker.log" 2>&1 & echo $! >"$RUN/worker.pid")
    fi
    echo
    bold "Cadenza is running"
    echo "  Your site:  http://127.0.0.1:$APP_PORT   ← open this; the first time you create the owner account"
    echo "              then the Cadenza bar is at the bottom (sign in later at /_cadenza/login)"
    echo "  Studio:     http://127.0.0.1:$STUDIO_PORT (API used by the panel)"
}

stop() {
    if has symfony && [ -z "${CADENZA_PHP_SERVER:-}" ]; then
        (cd "$APP" && symfony server:stop >/dev/null 2>&1 || true)
        (cd "$STUDIO" && symfony server:stop >/dev/null 2>&1 || true)
    fi
    # PHP's built-in server forks workers (PHP_CLI_SERVER_WORKERS); match all of them by this checkout's router.
    pkill -f "$ROOT/bin/router.php" 2>/dev/null || true
    # The worker too, also one left behind by an earlier start whose pid file was overwritten.
    pkill -f "$APP/bin/console messenger:consume" 2>/dev/null || true
    for pid in "$RUN"/*.pid; do
        [ -f "$pid" ] || continue
        kill "$(cat "$pid")" 2>/dev/null || true
        rm -f "$pid"
    done
    echo "Stopped."
}

tests() {
    step "runtime-bundle"
    (cd "$ROOT/runtime-bundle" && { [ -d vendor ] || composer install --no-interaction --quiet; } && vendor/bin/phpunit)
    step "harness"
    (cd "$STUDIO" && php bin/phpunit)
    step "demo-app"
    (cd "$APP" && php bin/phpunit)
}

case "${1:-}" in
    setup) setup ;;
    start) start ;;
    stop) stop ;;
    test) tests ;;
    reset) (cd "$APP" && printf 'yes\n' | php bin/console cadenza:reset "My site" --hard) ;;
    *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
