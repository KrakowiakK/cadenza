#!/bin/sh
# Starts the Cadenza studio with the model API keys taken from 1Password (`secret`, see ~/.claude/CLAUDE.md).
# Keys live only in the server's environment; they are never written to .env files or logs.
set -e
cd "$(dirname "$0")/.."
CADENZA_LLM_API_KEY="$(secret get OLLAMA_API)"
CADENZA_LLM_FALLBACK_API_KEY="$(secret get OPENROUTER_API_KEY)"
CADENZA_LLM_VISION_API_KEY="$CADENZA_LLM_FALLBACK_API_KEY"
# Ollama Cloud's free Gemma looks at screenshots of widgets under test (OpenRouter's free models are rate-limited).
CADENZA_REVIEW_MODEL="${CADENZA_REVIEW_MODEL:-gemma4:31b}"
# gpt-oss proofreads Polish replies best of the free models (spelling and forms).
CADENZA_PROOFREAD_MODEL="${CADENZA_PROOFREAD_MODEL:-gpt-oss:120b}"
export CADENZA_LLM_API_KEY CADENZA_LLM_FALLBACK_API_KEY CADENZA_LLM_VISION_API_KEY CADENZA_REVIEW_MODEL CADENZA_PROOFREAD_MODEL
symfony server:stop >/dev/null 2>&1 || true
symfony server:start -d --port=8011 --no-tls
