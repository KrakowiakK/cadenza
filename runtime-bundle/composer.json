{
    "name": "cadenza/runtime-bundle",
    "description": "Cadenza runtime: page tree, renderer, sketches and the owner's chat panel for a living Symfony app.",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "doctrine/doctrine-bundle": "^2.13|^3.0",
        "doctrine/orm": "^3.3",
        "symfony/framework-bundle": "^8.1",
        "symfony/mcp-bundle": "^1.0@beta",
        "symfony/twig-bundle": "^8.1",
        "symfony/ux-twig-component": "^2.20|^3.0",
        "twig/markdown-extra": "^3.10",
        "league/commonmark": "^2.5",
        "nyholm/psr7": "^1.8",
        "symfony/ux-icons": "^2.20|^3.0",
        "tales-from-a-dev/twig-tailwind-extra": "^1.3",
        "twig/html-extra": "^3.24"
    },
    "autoload": {
        "psr-4": {
            "Cadenza\\Runtime\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cadenza\\Runtime\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
