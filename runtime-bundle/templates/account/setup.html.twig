{% extends '@CadenzaRuntime/layout.html.twig' %}
{% block title %}Setup · {{ cadenza_state().document.name }}{% endblock %}
{% block main %}
{%- set lang = cadenza_state().language -%}
{%- set field = 'h-11 w-full rounded-[calc(var(--radius)*0.8)] border border-input bg-background px-3.5 text-base outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20' -%}
{% set body %}
<form method="post" data-turbo="false" class="grid gap-4">
    {%- if error %}<p class="rounded-lg bg-destructive/10 px-3.5 py-2.5 text-sm text-destructive" role="alert">{{ ('account.error.' ~ error)|trans({}, 'cadenza', lang) }}</p>{% endif %}
    <label class="grid gap-1.5 text-sm font-medium">{{ ('account.name'|trans({}, 'cadenza', lang)) }}<input type="text" name="name" autocomplete="name" class="{{ field }}"></label>
    <label class="grid gap-1.5 text-sm font-medium">{{ ('account.email'|trans({}, 'cadenza', lang)) }}<input type="email" name="email" value="{{ email }}" autocomplete="username" required autofocus class="{{ field }}"></label>
    <label class="grid gap-1.5 text-sm font-medium">{{ ('account.password'|trans({}, 'cadenza', lang)) }}<input type="password" name="password" minlength="10" autocomplete="new-password" required class="{{ field }}"></label>
    <label class="grid gap-1.5 text-sm font-medium">{{ ('account.repeat'|trans({}, 'cadenza', lang)) }}<input type="password" name="repeat" minlength="10" autocomplete="new-password" required class="{{ field }}"></label>
    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
    <twig:Button type="submit" class="h-11 w-full text-base">{{ ('account.create'|trans({}, 'cadenza', lang)) }}</twig:Button>
</form>
{% endset %}
{% include '@CadenzaRuntime/account/_card.html.twig' with {icon: 'key-round', heading: ('account.setup'|trans({}, 'cadenza', lang)), lead: ('account.setup_lead'|trans({}, 'cadenza', lang)), body: body, foot: ('account.setup_foot'|trans({}, 'cadenza', lang))} %}
{% endblock %}
