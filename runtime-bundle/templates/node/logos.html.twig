{% include '@CadenzaRuntime/node/_section_open.html.twig' %}
{% include '@CadenzaRuntime/node/_head.html.twig' %}
{%- macro logo(item) -%}
    <div class="flex h-14 shrink-0 items-center justify-center px-8 opacity-60 grayscale transition hover:opacity-100 hover:grayscale-0">
        {%- if item.image|default(false) %}<img src="{{ item.image }}" alt="{{ item.name }}" class="max-h-10 w-auto object-contain">{% else %}<span class="cz-heading text-xl font-semibold tracking-tight">{{ item.name }}</span>{% endif %}
    </div>
{%- endmacro -%}
{%- if props.style == 'marquee' %}
    <div class="cz-marquee"><div>{% for i in 1..2 %}{% for item in props.items %}{{ _self.logo(item) }}{% endfor %}{% endfor %}</div></div>
{%- else %}
    <div class="flex flex-wrap items-center justify-center gap-y-4">{% for item in props.items %}{{ _self.logo(item) }}{% endfor %}</div>
{%- endif %}
{% include '@CadenzaRuntime/node/_section_close.html.twig' %}
