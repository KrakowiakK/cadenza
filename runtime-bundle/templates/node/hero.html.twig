{%- set variant = props.variant ?? (props.image and props.imagePosition == 'right' ? 'split' : (props.image and props.imagePosition != 'none' ? 'image' : 'typographic')) -%}
{%- set heroWidget = cadenza_widget(props.widget|default(null)) -%}
{%- set hasImage = props.image or props.images is not empty or (heroWidget and variant == 'split') -%}
{#- Without a photo: the owner's sketch shows where it will go; the published site falls back to the typographic layout. -#}
{%- set placeholder = not hasImage and variant != 'typographic' and cadenza_state().owner and cadenza_state().isSketch -%}
{%- if not hasImage and not placeholder -%}{%- set variant = 'typographic' -%}{%- endif -%}
{%- if placeholder and variant == 'image' -%}{%- set variant = 'split' -%}{%- endif -%}
{%- set heights = {sm: 'py-20', md: 'py-24 md:py-36', lg: 'py-32 md:py-48', screen: 'min-h-[88vh] flex items-center py-24'} -%}
{%- set centered = props.align == 'center' and variant in ['image', 'typographic'] -%}
{%- set actions -%}
    {%- if node.slots.actions|default([]) is not empty %}<div class="mt-10 flex flex-wrap gap-3 {{ centered ? 'justify-center' : '' }}">{{ cadenza_slot(node, 'actions') }}</div>{% endif %}
{%- endset -%}
{%- set text -%}
    {%- if props.eyebrow %}<p class="cz-eyebrow mb-5 {{ variant == 'image' ? '!text-white/85' : '' }}">{{ props.eyebrow }}</p>{% endif %}
    <h1 class="cz-display {{ variant == 'typographic' ? 'text-5xl md:text-8xl' : 'text-4xl md:text-7xl' }}">{{ props.title }}</h1>
    {%- if props.subtitle %}<p class="cz-lead mt-6 text-lg md:text-xl {{ variant == 'image' ? 'text-white/85' : 'text-muted-foreground' }} {{ centered ? 'mx-auto' : '' }} max-w-2xl">{{ props.subtitle|nl2br }}</p>{% endif %}
    {{ actions }}
{%- endset -%}

{%- if variant == 'image' and props.image %}
<section class="relative overflow-hidden text-white {{ heights[props.height] }}">
    <img src="{{ props.image }}" alt="" class="absolute inset-0 h-full w-full scale-105 object-cover" style="animation: cz-hero-zoom 18s ease-out both">
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/35 to-black/70"></div>
    <div class="relative mx-auto w-full max-w-6xl px-6 {{ centered ? 'text-center' : '' }}"><div class="{{ centered ? 'mx-auto max-w-4xl' : 'max-w-3xl' }}">{{ text }}</div></div>
</section>
{%- elseif variant == 'split' %}
<section class="relative overflow-hidden {{ heights[props.height] }}">
    <div class="mx-auto grid w-full max-w-6xl items-center gap-12 px-6 md:grid-cols-[1.1fr_1fr]">
        <div>{{ text }}</div>
        <div class="relative">
            <div class="absolute -inset-4 -z-10 rounded-[calc(var(--radius)*2)] bg-primary/10 blur-2xl"></div>
            {%- if heroWidget and not props.image %}{% include '@CadenzaRuntime/node/_widget_frame.html.twig' with {widget: heroWidget, name: props.widget, class: 'aspect-[4/5] w-full'} %}
            {%- elseif props.image %}<img src="{{ props.image }}" alt="" class="cz-img aspect-[4/5] w-full object-cover shadow-2xl md:aspect-[4/5]">
            {%- else %}<div class="cz-img flex aspect-[4/5] w-full flex-col items-center justify-center gap-3 border-2 border-dashed border-current/15 bg-muted/60 text-muted-foreground">{{ cadenza_icon('image-plus', 'size-10 opacity-50') }}</div>{% endif %}
        </div>
    </div>
</section>
{%- elseif variant == 'collage' %}
{%- set imgs = props.images|default([])|merge(props.image ? [props.image] : [])|slice(0, 3) -%}
<section class="relative overflow-hidden {{ heights[props.height] }}">
    <div class="mx-auto grid w-full max-w-6xl items-center gap-12 px-6 md:grid-cols-2">
        <div>{{ text }}</div>
        <div class="relative h-[26rem] md:h-[32rem]">
            {%- for src in imgs %}
                <img src="{{ src }}" alt="" class="cz-img absolute object-cover shadow-2xl ring-4 ring-background {{ ['left-0 top-6 h-64 w-[58%] -rotate-3 md:h-80', 'right-0 top-0 h-56 w-[48%] rotate-3 md:h-72', 'bottom-0 left-[22%] h-52 w-[52%] rotate-1 md:h-64'][loop.index0] }}">
            {%- else %}
                <div class="cz-img absolute inset-8 flex items-center justify-center border-2 border-dashed border-current/15 bg-muted/60 text-muted-foreground">{{ cadenza_icon('images', 'size-10 opacity-50') }}</div>
            {%- endfor %}
        </div>
    </div>
</section>
{%- else %}
<section class="relative overflow-hidden {{ heights[props.height] }}">
    {%- if heroWidget %}{% include '@CadenzaRuntime/node/_widget_frame.html.twig' with {widget: heroWidget, name: props.widget, class: 'pointer-events-none !absolute inset-0 h-full', decorative: true} %}{% endif %}
    <div class="pointer-events-none absolute -top-40 left-1/2 h-[36rem] w-[60rem] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl"></div>
    <div class="relative mx-auto w-full max-w-6xl px-6 {{ centered ? 'text-center' : '' }}"><div class="{{ centered ? 'mx-auto max-w-5xl' : 'max-w-4xl' }}">{{ text }}</div></div>
</section>
{%- endif %}
