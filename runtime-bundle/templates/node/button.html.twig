<twig:Button as="a" href="{{ props.href }}" variant="{{ props.variant }}" size="{{ props.size }}" class="{{ props.size == 'lg' ? 'h-11 px-6 text-base' : '' }}{{ props.variant == 'outline' ? ' text-foreground' : '' }}">
    {{ props.label }}{% if props.icon %} {{ cadenza_icon(props.icon, 'size-4') }}{% endif %}
</twig:Button>
