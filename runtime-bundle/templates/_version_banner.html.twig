{%- set v = cadenza_state().previewVersion -%}
<div id="cz-version-banner" class="cz-ui sticky top-0 z-40 border-b border-sky-300/60 bg-sky-50/95 text-sky-950 backdrop-blur dark:bg-sky-950/90 dark:text-sky-50" data-cz-version="{{ v.number }}">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-4 gap-y-2 px-6 py-2.5 text-sm">
        <span class="font-semibold"><span data-cz-i18n="version">Version</span> {{ v.number }}</span>
        <span class="min-w-0 flex-1 truncate opacity-80">{{ v.summary }} · {{ v.publishedAt|date('Y-m-d H:i') }}</span>
        {%- if v.number == cadenza_state().currentNumber %}
            <span class="rounded-full bg-sky-600/15 px-2 py-0.5 text-xs font-medium" data-cz-i18n="current">current</span>
        {%- else %}
            <button type="button" data-cz-action="restore" data-version="{{ v.number }}" class="rounded-lg bg-sky-900 px-3 py-1.5 text-xs font-semibold text-sky-50 shadow-sm hover:bg-sky-800 dark:bg-sky-200 dark:text-sky-950" data-cz-i18n="restore">Restore this version</button>
        {%- endif %}
        <button type="button" data-cz-action="close-preview" class="rounded-lg px-3 py-1.5 text-xs font-medium hover:bg-sky-900/10 dark:hover:bg-white/10" data-cz-i18n="close">Close</button>
    </div>
</div>
