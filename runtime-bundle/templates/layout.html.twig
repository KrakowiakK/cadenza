{%- set state = cadenza_state() -%}
{%- set doc = state.document -%}
<!DOCTYPE html>
<html lang="{{ state.language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ page.title|default('') }}{{ page is defined and page ? ' · ' : '' }}{{ doc.name }}{% endblock %}</title>
    {%- if page is defined and page and page.description %}<meta name="description" content="{{ page.description }}">{% endif %}
    <meta name="view-transition" content="same-origin">
    <meta name="turbo-refresh-method" content="morph">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="{{ cadenza_fonts_url(doc.theme) }}">
    <style id="cz-theme">{{ cadenza_theme_css(doc.theme) }}</style>
    {{ importmap('app') }}
    <script type="module" src="{{ asset('@cadenza/runtime/site.js') }}"></script>
    {%- if state.owner and not state.embed %}
        <meta name="cz-harness" content="{{ cadenza_harness_url }}">
        <meta name="cz-token" content="{{ cadenza_token }}">
        {%- if state.isSketch %}<meta name="cz-draft" content="{{ state.draftId }}">{% endif %}
        {%- if state.previewVersion %}<meta name="cz-version" content="{{ state.previewVersion.number }}">{% endif %}
        <script type="module" src="{{ asset('@cadenza/runtime/panel.js') }}"></script>
    {%- endif %}
</head>
{#- Theme attributes live on <body>: Turbo swaps the body on navigation, but not the <html> element. -#}
{#- lang also on <body>: Turbo swaps the body when moving between pages in different languages. -#}
<body lang="{{ state.language }}" data-cz-style="{{ doc.theme.style|default('minimal') }}" class="{{ doc.theme.mode|default('light') == 'dark' ? 'dark ' : '' }}flex min-h-screen flex-col bg-background text-foreground antialiased{{ state.isSketch and not state.embed ? ' cz-sketch' : '' }}{{ state.embed ? ' cz-embed' : '' }}{{ state.showBefore ? ' cz-before' : '' }}">
    {%- if state.isSketch and not state.embed %}{% include '@CadenzaRuntime/_sketch_banner.html.twig' %}{% endif %}
    {%- if state.previewVersion %}{% include '@CadenzaRuntime/_version_banner.html.twig' %}{% endif %}
    {%- set note = doc.announcement|default(null) -%}
    {%- if note and note.text|default(false) and (note.until is not defined or note.until|date('Y-m-d') >= 'now'|date('Y-m-d')) %}
    <div data-cz-announcement="{{ note.text|length }}-{{ note.text|slice(0, 24)|url_encode }}" class="relative bg-primary px-12 py-2.5 text-center text-sm font-medium text-primary-foreground" style="view-transition-name:cz-announcement">
        {%- if note.href|default(null) %}<a href="{{ note.href }}" class="underline-offset-4 hover:underline">{{ note.text }} →</a>{% else %}{{ note.text }}{% endif %}
        <button type="button" data-cz-announcement-close aria-label="×" class="absolute top-1/2 right-3 -translate-y-1/2 rounded-full p-1.5 opacity-70 transition hover:bg-white/15 hover:opacity-100">{{ cadenza_icon('x', 'size-4') }}</button>
    </div>
    {%- endif %}
    {%- set navItems = cadenza_nav(doc, page is defined and page ? page : null) -%}
    {%- set navItems = navItems|length > 1 ? navItems : [] -%}
    {%- set translations = page is defined and page ? cadenza_translations(doc, page) : [] -%}
    {%- set translations = translations|length > 1 ? translations : [] -%}
    <header class="sticky top-0 z-30 border-b border-border/60 bg-background/85 backdrop-blur" style="view-transition-name:cz-header">
        <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6">
            <a href="/" class="cz-heading min-w-0 truncate py-2 text-lg font-bold tracking-tight">{{ doc.name }}</a>
            {#- Wide screens: the menu in the bar. -#}
            <nav class="hidden items-center gap-1 text-sm md:flex">
                {%- for item in navItems %}
                    <a href="{{ item.href }}" class="rounded-md px-3 py-2 whitespace-nowrap transition hover:bg-muted {{ page is defined and page and page.path == item.href ? 'font-semibold text-foreground' : 'text-muted-foreground' }}">{% if item.members %}{{ cadenza_icon('lock', 'size-3 inline mr-1 opacity-60') }}{% endif %}{{ item.label }}</a>
                {%- endfor %}
            </nav>
            {%- if translations %}
            <div class="hidden shrink-0 items-center gap-0.5 rounded-full border border-border/70 p-0.5 text-xs font-medium uppercase md:flex" aria-label="Language">
                {%- for tr in translations %}<a href="{{ tr.href }}" hreflang="{{ tr.lang }}" lang="{{ tr.lang }}" class="rounded-full px-2.5 py-1 transition {{ tr.current ? 'bg-foreground text-background' : 'text-muted-foreground hover:text-foreground' }}">{{ tr.lang }}</a>{% endfor %}
            </div>
            {%- endif %}
            {#- Phones: one button, the menu and languages drop down (no JavaScript needed). -#}
            {%- if navItems or translations %}
            <details class="cz-mobile-nav relative shrink-0 md:hidden">
                <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-full border border-border/70 px-3 py-1.5 text-sm font-medium [&::-webkit-details-marker]:hidden" aria-label="Menu">{{ cadenza_icon('menu', 'size-4') }}<span>{{ state.language == 'pl' ? 'Menu' : 'Menu' }}</span></summary>
                <div class="absolute right-0 mt-2 w-64 rounded-2xl border border-border bg-background p-2 shadow-xl">
                    {%- for item in navItems %}
                        <a href="{{ item.href }}" class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-base {{ page is defined and page and page.path == item.href ? 'font-semibold' : '' }} hover:bg-muted">{% if item.members %}{{ cadenza_icon('lock', 'size-3.5 opacity-60') }}{% endif %}{{ item.label }}</a>
                    {%- endfor %}
                    {%- if translations %}
                    <div class="mt-1 flex gap-1 border-t border-border px-1 pt-2 text-xs font-medium uppercase">
                        {%- for tr in translations %}<a href="{{ tr.href }}" hreflang="{{ tr.lang }}" lang="{{ tr.lang }}" class="flex-1 rounded-lg px-2 py-2 text-center {{ tr.current ? 'bg-foreground text-background' : 'bg-muted' }}">{{ tr.lang }}</a>{% endfor %}
                    </div>
                    {%- endif %}
                </div>
            </details>
            {%- endif %}
        </div>
    </header>
    <main class="flex-1" id="cz-main">
        {% block main %}{% endblock %}
    </main>
    <footer class="border-t border-border/60 py-10 text-sm text-muted-foreground" style="view-transition-name:cz-footer">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-6">
            <span>{{ doc.footer.text|default('© ' ~ 'now'|date('Y') ~ ' ' ~ doc.name) }}</span>
            <span class="flex items-center gap-4">
                {%- if doc.tagline %}<span>{{ doc.tagline }}</span>{% endif %}
                {%- if not state.embed %}
                    {%- set lang = state.language -%}
                    {%- if state.owner %}<a href="/_cadenza/dashboard" class="inline-block py-2 text-xs opacity-70 hover:opacity-100">{{ cadenza_icon('layout-dashboard', 'size-3.5 inline') }}</a><a href="{{ path('cadenza_logout') }}" data-turbo="false" class="inline-block py-2 text-xs opacity-70 hover:opacity-100">{{ 'account.logout'|trans({}, 'cadenza', lang) }}</a>
                    {%- elseif app.user %}<span class="text-xs opacity-70">{{ app.user.name ?: app.user.email }}</span><a href="{{ path('cadenza_logout') }}" data-turbo="false" class="inline-block py-2 text-xs opacity-70 hover:opacity-100">{{ 'account.logout'|trans({}, 'cadenza', lang) }}</a>
                    {%- else %}<a href="/_cadenza/login" class="inline-block py-2 text-xs opacity-40 hover:opacity-100" rel="nofollow">{{ 'account.sign_in_link'|trans({}, 'cadenza', lang) }}</a>{% endif %}
                {%- endif %}
            </span>
        </div>
    </footer>
    {%- if state.owner and not state.embed %}{% include '@CadenzaRuntime/panel/_panel.html.twig' %}{% endif %}
</body>
</html>
