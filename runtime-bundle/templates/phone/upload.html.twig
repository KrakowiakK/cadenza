{%- set pl = locale == 'pl' -%}
<!doctype html>
<html lang="{{ locale }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#7c3aed">
<title>Cadenza · {{ pl ? 'Wyślij zdjęcia' : 'Send photos' }}</title>
<style>
  *{box-sizing:border-box} body{margin:0;font:16px/1.4 -apple-system,system-ui,sans-serif;color:#18181b;background:#faf9fb;min-height:100vh;padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom)}
  header{padding:28px 22px 8px;text-align:center} .logo{width:52px;height:52px;border-radius:16px;margin:0 auto 14px;background:linear-gradient(135deg,#8b5cf6,#d946ef);display:grid;place-items:center;color:#fff;font-size:26px}
  h1{font-size:22px;margin:0 0 6px} p.lead{margin:0;color:#71717a}
  main{padding:18px} .pick{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:20px;border:0;border-radius:18px;background:#18181b;color:#fff;font-size:18px;font-weight:600}
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:16px} .tile{position:relative;aspect-ratio:1;border-radius:10px;overflow:hidden;background:#eee} .tile img{width:100%;height:100%;object-fit:cover}
  .tile .st{position:absolute;inset:0;display:grid;place-items:center;background:rgba(0,0,0,.35);color:#fff;font-size:22px} .tile.ok .st{background:transparent;align-items:end;justify-items:end;padding:6px;font-size:16px}
  .bar{height:8px;border-radius:9px;background:#e4e4e7;overflow:hidden;margin-top:16px} .bar div{height:100%;width:0;background:linear-gradient(90deg,#8b5cf6,#d946ef);transition:width .3s}
  .done{display:none;text-align:center;padding:30px 10px} .done .big{font-size:56px} .muted{color:#71717a;font-size:14px;text-align:center;margin-top:10px}
  .finish{width:100%;margin-top:14px;padding:16px;border-radius:16px;border:2px solid #18181b;background:#fff;font-size:17px;font-weight:600;display:none}
</style>
</head>
<body>
<header>
  <div class="logo">✦</div>
  <h1>{{ pl ? 'Wyślij zdjęcia na swoją stronę' : 'Send photos to your site' }}</h1>
  <p class="lead">{{ pl ? 'Wybierz je z galerii telefonu — Cadenza ułoży je w albumy.' : 'Pick them from your camera roll — Cadenza turns them into albums.' }}</p>
</header>
<main>
  <section id="picker">
    <input id="file" type="file" accept="image/*" multiple hidden>
    <button class="pick" id="pick">📷 {{ pl ? 'Wybierz zdjęcia' : 'Choose photos' }}</button>
    <div class="bar" hidden id="bar"><div></div></div>
    <p class="muted" id="count"></p>
    <div class="grid" id="grid"></div>
    <button class="finish" id="finish">{{ pl ? 'Gotowe — wyślij na stronę' : 'Done — send to my site' }}</button>
  </section>
  <section class="done" id="done">
    <div class="big">🎉</div>
    <h1>{{ pl ? 'Gotowe!' : 'Done!' }}</h1>
    <p class="lead" id="summary"></p>
    <p class="muted">{{ pl ? 'Wróć do komputera — Cadenza już układa galerię.' : 'Back to your computer — Cadenza is building the gallery.' }}</p>
  </section>
</main>
<script>
const token = {{ token|json_encode|raw }};
const pl = {{ pl ? 'true' : 'false' }};
const $ = (id) => document.getElementById(id);
let total = 0, sent = 0, running = 0;
const queue = [];

$('pick').onclick = () => $('file').click();
$('file').onchange = () => {
  for (const file of $('file').files) {
    const tile = document.createElement('div');
    tile.className = 'tile';
    tile.innerHTML = `<img alt=""><span class="st">⏳</span>`;
    tile.querySelector('img').src = URL.createObjectURL(file);
    $('grid').prepend(tile);
    queue.push({ file, tile });
    total++;
  }
  $('file').value = '';
  $('bar').hidden = false;
  pump();
};

// Phones send large photos; shrink them to 2400 px before upload (keeps it fast on mobile data).
async function shrink(file) {
  if (!/^image\/(jpeg|png|webp)$/.test(file.type) || file.size < 1.5e6) return file;
  try {
    const bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });
    const scale = Math.min(1, 2400 / Math.max(bitmap.width, bitmap.height));
    if (scale === 1 && file.size < 4e6) return file;
    const canvas = new OffscreenCanvas(Math.round(bitmap.width * scale), Math.round(bitmap.height * scale));
    canvas.getContext('2d').drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    // Canvas drops EXIF (date, place): send the original when it is small enough to keep them.
    return file.size < 12e6 ? file : await canvas.convertToBlob({ type: 'image/jpeg', quality: 0.86 });
  } catch { return file; }
}

function pump() {
  while (running < 3 && queue.length) {
    const { file, tile } = queue.shift();
    running++;
    shrink(file).then((blob) => {
      const form = new FormData();
      form.append('photo', blob, file.name || 'photo.jpg');
      return fetch(`/_cadenza/phone/${token}/upload`, { method: 'POST', body: form });
    }).then((r) => {
      tile.classList.toggle('ok', r.ok);
      tile.querySelector('.st').textContent = r.ok ? '✓' : '⚠︎';
    }).catch(() => { tile.querySelector('.st').textContent = '⚠︎'; })
    .finally(() => {
      running--; sent++;
      $('bar').firstElementChild.style.width = Math.round(sent / total * 100) + '%';
      $('count').textContent = pl ? `Wysłano ${sent} z ${total}` : `Sent ${sent} of ${total}`;
      $('finish').style.display = sent === total ? 'block' : 'none';
      pump();
    });
  }
}

$('finish').onclick = async () => {
  $('finish').disabled = true;
  $('finish').textContent = pl ? 'Układam albumy…' : 'Making albums…';
  const res = await fetch(`/_cadenza/phone/${token}/finish`, { method: 'POST' }).then((r) => r.json()).catch(() => ({}));
  const albums = Object.keys(res.albums ?? {});
  $('picker').style.display = 'none';
  $('done').style.display = 'block';
  $('summary').textContent = (pl ? `${sent} zdjęć` : `${sent} photos`) + (albums.length ? ` · ${albums.join(' · ')}` : '');
};
</script>
</body>
</html>
