{%- set s = cadenza_state() -%}
{%- set sum = s.diff.summary -%}
<div id="cz-sketch-banner" class="cz-ui sticky top-0 z-40 border-b border-amber-300/60 bg-amber-50/95 text-amber-950 backdrop-blur dark:bg-amber-950/90 dark:text-amber-50" data-cz-draft="{{ s.draftId }}">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-4 gap-y-2 px-6 py-2.5 text-sm">
        <span class="inline-flex items-center gap-2 font-semibold"><span class="cz-pulse-dot"></span><span data-cz-i18n="sketch">Sketch</span></span>
        <span class="min-w-0 flex-1 truncate opacity-80" data-cz-sketch-summary>{{ s.draftSummary|default('') }}</span>
        <span class="flex items-center gap-2 text-xs">
            {%- if sum.added|default(0) %}<span class="rounded-full bg-emerald-600/15 px-2 py-0.5 font-medium text-emerald-800 dark:text-emerald-200">+{{ sum.added }}</span>{% endif %}
            {%- if sum.changed|default(0) %}<span class="rounded-full bg-sky-600/15 px-2 py-0.5 font-medium text-sky-800 dark:text-sky-200">~{{ sum.changed }}</span>{% endif %}
            {%- if sum.removed|default(0) %}<span class="rounded-full bg-rose-600/15 px-2 py-0.5 font-medium text-rose-800 dark:text-rose-200">−{{ sum.removed }}</span>{% endif %}
            {%- if sum.theme|default(false) %}<span class="rounded-full bg-violet-600/15 px-2 py-0.5 font-medium text-violet-800 dark:text-violet-200" data-cz-i18n="themeChanged">theme</span>{% endif %}
            {%- if sum.site|default(false) %}<span class="rounded-full bg-violet-600/15 px-2 py-0.5 font-medium text-violet-800 dark:text-violet-200" data-cz-i18n="siteChanged">site</span>{% endif %}
            {%- if sum.pagesAdded|default(0) %}<span class="rounded-full bg-emerald-600/15 px-2 py-0.5 font-medium text-emerald-800 dark:text-emerald-200">+{{ sum.pagesAdded }} <span data-cz-i18n="pages">pages</span></span>{% endif %}
        </span>
        <label class="inline-flex cursor-pointer items-center gap-1.5 text-xs select-none"><input type="checkbox" data-cz-action="marks" class="accent-amber-800"><span data-cz-i18n="showChanges">Show changes</span></label>
        <div class="inline-flex rounded-lg bg-amber-900/10 p-0.5 text-xs dark:bg-white/10">
            <button type="button" data-cz-action="before" class="rounded-md px-2.5 py-1 {{ s.showBefore ? 'bg-white font-semibold shadow-sm dark:bg-white/20' : '' }}" data-cz-i18n="before">Before</button>
            <button type="button" data-cz-action="after" class="rounded-md px-2.5 py-1 {{ s.showBefore ? '' : 'bg-white font-semibold shadow-sm dark:bg-white/20' }}" data-cz-i18n="after">After</button>
        </div>
        <button type="button" data-cz-action="reject" class="rounded-lg px-3 py-1.5 text-xs font-medium hover:bg-amber-900/10 dark:hover:bg-white/10" data-cz-i18n="reject">Reject</button>
        <button type="button" data-cz-action="approve" class="rounded-lg bg-amber-900 px-3 py-1.5 text-xs font-semibold text-amber-50 shadow-sm hover:bg-amber-800 dark:bg-amber-200 dark:text-amber-950" data-cz-i18n="approve">Approve</button>
    </div>
</div>
